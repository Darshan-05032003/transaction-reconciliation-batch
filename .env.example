# Copy to .env and adjust. The application reads these as environment variables;
# docker-compose reads the same file for the PostgreSQL container.

# Profile: dev (default), test or prod
SPRING_PROFILES_ACTIVE=dev

# Database (DB_NAME is used by docker-compose only; the application uses DB_URL)
DB_NAME=recon
DB_URL=jdbc:postgresql://localhost:5434/recon
DB_USERNAME=recon
DB_PASSWORD=recon

# HTTP
SERVER_PORT=8083

# File lifecycle folders (relative paths are resolved against the working directory)
RECON_INBOX_DIR=data/inbox
RECON_ARCHIVE_DIR=data/archive
RECON_FAILED_DIR=data/failed
RECON_ERROR_DIR=data/error
RECON_REPORTS_DIR=data/reports

# Batch tuning
RECON_CHUNK_SIZE=500
RECON_GRID_SIZE=4
RECON_SKIP_LIMIT=100

# Matching tolerances
RECON_AMOUNT_TOLERANCE=0.00
RECON_DATE_TOLERANCE_DAYS=3

# Inbox polling schedule (Spring cron, six fields; "-" disables polling)
RECON_POLL_CRON=0 */5 * * * *

# Write-offs with an exposure above this amount need approval by a second user
RECON_WRITE_OFF_APPROVAL_THRESHOLD=10000.00

# Dev-profile API users, created at startup with BCrypt-hashed passwords.
# A user whose password is empty is not created. Export these before starting the app.
RECON_DEV_VIEWER_USERNAME=viewer
RECON_DEV_VIEWER_PASSWORD=viewer-dev
RECON_DEV_OPERATOR_USERNAME=operator
RECON_DEV_OPERATOR_PASSWORD=operator-dev
RECON_DEV_APPROVER_USERNAME=approver
RECON_DEV_APPROVER_PASSWORD=approver-dev
